# Yap API environment template. This file is safe to publish on GitHub.
# Copy it to apps/api/.env and fill in only the providers you want to use.
# The root .env is not loaded by the workspace commands.
# For frontend settings, copy apps/web/.env.example to apps/web/.env instead.
# Keep actual keys in the ignored .env files; leave this template blank.

HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173
# Relative paths below resolve from apps/api when using npm workspace commands.
API_DATA_FILE=./data/projects.json
SOCIAL_DATA_FILE=./data/social-investigations.json

# Local guided mode works without API keys. Set openai for model assistance.
WORKFLOW_PROVIDER=guided
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional live public research providers.
FIRECRAWL_API_KEY=
X_BEARER_TOKEN=
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Optional Deep Agents research: choose a supported OpenAI model ID.
DEEPAGENTS_MODEL=
# Leave empty to reuse OPENAI_API_KEY.
DEEPAGENTS_OPENAI_API_KEY=

# Optional local workflow storage overrides.
# WORKFLOW_DATA_FILE=./data/workflows.json
# WORKFLOW_ASSETS_DIRECTORY=./data/photos
# WORKFLOW_RENDERS_DIRECTORY=./data/videos

# Optional AWS S3 MP4 export. Use an existing private bucket in this region.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=exports/
# Use an already configured local profile, or a deployed service IAM role.
# AWS_PROFILE=yap
# Alternative: environment credentials, including a token for temporary keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
