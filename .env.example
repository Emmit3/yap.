# Yap API environment template, published at the repository root for GitHub.
# API commands load optional root .env, then apps/api/.env overrides.
# Existing process environment values take precedence.
# For the frontend, copy apps/web/.env.example to apps/web/.env.
# Keep actual credentials in ignored .env files; leave template keys blank.

HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173
# Relative to apps/api when started with npm run dev:api from the repository root.
API_DATA_FILE=./data/projects.json

# Public research providers. Keys stay on the API server; chat plugin connections
# do not automatically authorize the running application.
SOCIAL_DATA_FILE=./data/social-investigations.json
FIRECRAWL_API_KEY=
# Direct X/Grok adapters are disabled by this app's budget profile. Leave these
# empty; use indexed public discovery or import observed evidence instead.
X_BEARER_TOKEN=
XAI_API_KEY=
# Retained for the standalone adapter configuration, not enabled by this profile.
XAI_MODEL=grok-4.7

# Optional real LangChain Deep Agents research. The bounded budget profile uses
# gpt-6-luna; leave blank to omit the model-driven evidence review.
# The example replay needs no model key and never invokes live agents.
DEEPAGENTS_MODEL=
# Uses OPENAI_API_KEY when this research-specific override is empty.
DEEPAGENTS_OPENAI_API_KEY=

# Keep the guided engine for local development; select openai to interpret text and photos.
WORKFLOW_PROVIDER=guided
# Server-only. Never use a VITE_ prefix for provider credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Creator studio: fal Seedance 2.5; no automatic paid fallback.
# This is also the default provider when CREATOR_VIDEO_PROVIDER is omitted.
# FAL_KEY needs usable API access/credits; a Higgsfield website plan does not
# transfer an unlimited entitlement to fal or this server.
# OPENAI_API_KEY enables required frame review and optional narration, storyboard images,
# and reference-sample analysis. Each paid operation keeps its own quote/approval gate.
CREATOR_VIDEO_PROVIDER=fal
CREATOR_VIDEO_MODEL=seedance-2.5
FAL_KEY=
# Seedance 2.5 720p reserves USD 0.50/second, plus USD 0.10 per new clip review.
# Durable app reservation cap in USD, maximum 30.00. Keep provider auto-recharge
# disabled and allow room for checkout fees and usage outside this app.
CREATOR_BUDGET_LIMIT_USD=30.00
# Historical provider setting only; active generation profiles use fal.
RUNWAYML_API_SECRET=
# Both FAL_KEY and OPENAI_API_KEY (required frame review) are needed.
# Missing keys leave preparation available and production clearly disabled.
# Optional; defaults are beside API_DATA_FILE.
# WORKFLOW_DATA_FILE=./data/workflows.json
# WORKFLOW_ASSETS_DIRECTORY=./data/photos
# WORKFLOW_RENDERS_DIRECTORY=./data/videos

# Optional S3 export command: npm run aws:upload -- <path-to-mp4> from the repo root.
# Use an existing private bucket in this region. Nothing uploads automatically.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=exports/
# Use a configured local AWS profile, or the deployed service's IAM role.
# AWS_PROFILE=yap
# If using environment credentials instead, set all required values server-side:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
