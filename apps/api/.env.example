HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173
# Relative to apps/api when started with npm run dev:api from the repository root.
API_DATA_FILE=./data/projects.json

# Keep the guided engine for local development; select openai to interpret text and photos.
WORKFLOW_PROVIDER=guided
# Server-only. Never use a VITE_ prefix for provider credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional; defaults are beside API_DATA_FILE.
# WORKFLOW_DATA_FILE=./data/workflows.json
# WORKFLOW_ASSETS_DIRECTORY=./data/photos
# WORKFLOW_RENDERS_DIRECTORY=./data/videos
