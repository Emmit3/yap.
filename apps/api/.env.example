HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173
# Relative to apps/api when started with npm run dev:api from the repository root.
API_DATA_FILE=./data/projects.json

# Public research providers. Keys stay on the API server; chat plugin connections
# do not automatically authorize the running application.
SOCIAL_DATA_FILE=./data/social-investigations.json
FIRECRAWL_API_KEY=
X_BEARER_TOKEN=
XAI_API_KEY=
# Set a model supported by your xAI account when enabling Grok X search.
XAI_MODEL=grok-4.7
