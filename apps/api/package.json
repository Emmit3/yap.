{
  "name": "@yap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "1.4.1",
    "@langchain/openai": "1.8.4",
    "@yap/contracts": "*",
    "cors": "^2.8.5",
    "deepagents": "1.16.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "langchain": "1.6.6",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
